# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.py text
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.yml text
*.yaml text
*.md text
*.txt text
*.sh text eol=lf
*.bat text eol=crlf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Declare files that will always have LF line endings on checkout
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.torrent binary
*.client linguist-language=JSON

# Archives
*.zip binary
*.tar binary
*.gz binary

# Documents
*.pdf binary
